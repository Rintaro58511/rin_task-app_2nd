{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ECRAuthorization",
            "Effect": "Allow",
            "Action": [
                "ecr:GetAuthorizationToken"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ECRPush",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchGetImage",
                "ecr:BatchCheckLayerAvailability",
                "ecr:CompleteLayerUpload",
                "ecr:GetDownloadUrlForLayer",
                "ecr:InitiateLayerUpload",
                "ecr:PutImage",
                "ecr:UploadLayerPart"
            ],
            "Resource": "arn:aws:ecr:ap-northeast-1:538498973932:repository/*"
        },
        {
            "Sid": "ECSTaskDefinition",
            "Effect": "Allow",
            "Action": [
                "ecs:RegisterTaskDefinition",
                "ecs:DescribeTaskDefinition"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ECSDeploy",
            "Effect": "Allow",
            "Action": [
                "ecs:UpdateService",
                "ecs:DescribeServices"
            ],
            "Resource": "arn:aws:ecs:ap-northeast-1:538498973932:service/rin-task-app-cluster/rin-task-app-task-service-05mi790b"
        },
        {
            "Sid": "PassECSTaskExecutionRole",
            "Effect": "Allow",
            "Action": [
                "iam:PassRole"
            ],
            "Resource": "arn:aws:iam::538498973932:role/ecsTaskExecutionRole"
        },
        {
            "Sid": "FrontendS3Deploy",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::rin-task-app-front"
        },
        {
            "Sid": "FrontendS3Objects",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::rin-task-app-front/*"
        },
        {
            "Sid": "CloudFrontInvalidation",
            "Effect": "Allow",
            "Action": [
                "cloudfront:CreateInvalidation"
            ],
            "Resource": "arn:aws:cloudfront::538498973932:distribution/EV5CGIBII36WA"
        },
        {
            "Sid": "RunMigrationTask",
            "Effect": "Allow",
            "Action": [
                "ecs:RunTask"
            ],
            "Resource": "arn:aws:ecs:ap-northeast-1:538498973932:task-definition/rin-task-app-task:*",
            "Condition": {
                "ArnEquals": {
                    "ecs:cluster": "arn:aws:ecs:ap-northeast-1:538498973932:cluster/rin-task-app-cluster"
                }
            }
        },
        {
            "Sid": "DescribeMigrationTask",
            "Effect": "Allow",
            "Action": [
                "ecs:DescribeTasks"
            ],
            "Resource": "arn:aws:ecs:ap-northeast-1:538498973932:task/rin-task-app-cluster/*"
        }
    ]
}
